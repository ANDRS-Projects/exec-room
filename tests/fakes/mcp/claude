#!/usr/bin/env python3
# Test double for `claude -p` with the Exec Room's own MCP servers: logs how each run was started (its
# server list file and what is in it, the MCP tools it may use and the ones blocked, whether ToolSearch is there,
# the agents' note, a room-built advisor's tools) to $ROOM_TEST_TMP/mcp-calls.ndjson. Never logs a token: only
# whether the header holds the suite's test token. By the message: reports an MCP tool the room didn't know in its
# start event. Emits stream-json.
import json, os, stat, sys

args = sys.argv[1:]
agent = args[args.index("--agent") + 1]
prompt = args[args.index("-p") + 1]
note = args[args.index("--append-system-prompt") + 1]
out = lambda o: print(json.dumps(o), flush=True)


def flag(name):
    if name not in args:
        return []
    i = args.index(name) + 1
    vals = []
    while i < len(args) and not args[i].startswith("--"):
        vals.append(args[i])
        i += 1
    return vals


config = flag("--mcp-config")
mcp = None
if config:
    path = config[0]
    with open(path) as f:
        servers = json.load(f)["mcpServers"]
    mcp = {"file": [os.path.basename(os.path.dirname(path)), os.path.exists(path), oct(stat.S_IMODE(os.stat(path).st_mode))],
           "servers": {sid: {"type": s.get("type"), "path": s["url"].split("/", 3)[-1],
                             "auth": "the test token" if s.get("headers", {}).get("Authorization") == "Bearer good-token" else "another token"}
                       for sid, s in sorted(servers.items())},
           "args_hold_token": any("good-token" in a for a in args)}
agents = json.loads(args[args.index("--agents") + 1])
start = note.find("What this room lets agents use:")
own = lambda t: t.startswith("mcp__") and not t.startswith("mcp__claude_ai_")
with open(os.path.join(os.environ["ROOM_TEST_TMP"], "mcp-calls.ndjson"), "a") as log:
    log.write(json.dumps({
        "agent": agent, "mcp": mcp, "strict": "--strict-mcp-config" in args,
        "allowed_mcp": sorted(t for t in flag("--allowedTools") if own(t)),
        "denied_mcp": sorted(t for t in flag("--disallowedTools") if own(t) or "Fakebooks" in t),
        "tool_search": "ToolSearch" in flag("--tools"),
        "note": note[start:note.find(" Anything else", start)] if start >= 0 else None,
        "github_note": ["can't open GitHub yourself" in note, "through this room's GitHub server (its tools are named mcp__hub__…)" in note],
        "advisor_tools": {k: sorted(t for t in a.get("tools", []) if t.startswith("mcp__")) for k, a in agents.items() if k.startswith("room-")},
        "linked_notion": "linked Notion pages" in prompt,
        # The rule for Notion rows, as Coen is told it (the room's databases and the columns agents fill).
        "rows_rule": note[note.find('"notion_row"'):note.find("\n", note.find('"notion_row"'))] if '"notion_row"' in note else None,
        "claude_notion": "blocked" if "mcp__claude_ai_Notion" in flag("--disallowedTools") else "allowed" if any(t.startswith("mcp__claude_ai_Notion__") for t in flag("--allowedTools")) else "neither",
    }) + "\n")

tools = ["Read", "Grep", "Glob", "ToolSearch", "mcp__books__read_a", "mcp__books__read_b"]
if "surprise" in prompt:
    tools.append("mcp__books__surprise")
out({"type": "system", "subtype": "init", "session_id": "mcp-session", "tools": tools})
out({"type": "stream_event", "parent_tool_use_id": None, "event": {"type": "message_start"}})
# "REC: {…}" in the message, once or more: each is proposed as it is (Notion through Connect).
recs = [r.split("\n\n[Added by the room server", 1)[0].strip() for r in prompt.split("REC:")[1:]]
text = "Done." + "".join(f"\n```recommendation\n{r}\n```\n" for r in recs)
out({"type": "stream_event", "parent_tool_use_id": None, "event": {"type": "content_block_delta", "delta": {"type": "text_delta", "text": text}}})
out({"type": "result", "is_error": False, "num_turns": 1, "total_cost_usd": 0.01, "session_id": "mcp-session"})
