#!/usr/bin/env python3
# Test double for `claude -p` with a room focus agent: when Coen's room note hands requests to a focus agent,
# he consults Juno with the owner's text and adds one line; Juno's reply carries two proposals (a Wren job
# and a GitHub issue). Logs what each run got to $ROOM_TEST_TMP/focus-calls.ndjson. Emits stream-json.
import json, os, sys

args = sys.argv[1:]
agent = args[args.index("--agent") + 1]
prompt = args[args.index("-p") + 1]
note = args[args.index("--append-system-prompt") + 1]
agents = json.loads(args[args.index("--agents") + 1])
out = lambda o: print(json.dumps(o), flush=True)
with open(os.path.join(os.environ["ROOM_TEST_TMP"], "focus-calls.ndjson"), "a") as log:
    log.write(json.dumps({"agent": agent, "hand_over": "This room's focus agent is Juno" in note,
                          "juno_card_rules": "## In the owner's Exec Room" in agents.get("room-juno", {}).get("prompt", ""),
                          "tess_card_rules": "## In the owner's Exec Room" in agents.get("room-tess", {}).get("prompt", "")}) + "\n")


def say(text, parent=None):
    out({"type": "stream_event", "parent_tool_use_id": parent, "event": {"type": "message_start"}})
    out({"type": "stream_event", "parent_tool_use_id": parent, "event": {"type": "content_block_delta", "delta": {"type": "text_delta", "text": text}}})


def rec(obj):
    return "\n```recommendation\n" + json.dumps(obj) + "\n```\n"


out({"type": "system", "subtype": "init", "session_id": "coen-session" if agent == "chief-operating-officer" else "maker-session"})
if agent != "chief-operating-officer":
    say("Draft done.")
elif "finished" in prompt:
    say("Reviewed.")
elif "This room's focus agent is Juno" in note:
    out({"type": "assistant", "parent_tool_use_id": None, "message": {"content": [{"type": "tool_use", "id": "M1", "name": "Agent", "input": {"subagent_type": "room-juno", "prompt": prompt}}]}})
    say("Position it as a calm launch." + rec({"action": "dispatch", "agent": "wren", "summary": "Launch post", "brief": "Write it."})
        + rec({"action": "github_issue", "repo": "exec-room", "summary": "Track the launch", "title": "Launch", "body": "Plan."}), "M1")
    out({"type": "user", "parent_tool_use_id": None, "message": {"content": [{"type": "tool_result", "tool_use_id": "M1", "content": "done"}]}})
    say("Asked Juno.")
else:
    say("No focus here.")
out({"type": "result", "is_error": False, "num_turns": 1, "total_cost_usd": 0.01, "session_id": "x"})
