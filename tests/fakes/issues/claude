#!/usr/bin/env python3
# Test double for `claude -p` for linked issues: logs each run's full prompt, --tools and --allowedTools to
# $ROOM_TEST_TMP/issues-calls.ndjson and replies "Read." Emits stream-json.
import json, os, sys, time

args = sys.argv[1:]


def flag(name):
    i = args.index(name) + 1
    vals = []
    while i < len(args) and not args[i].startswith("--"):
        vals.append(args[i])
        i += 1
    return vals


with open(os.path.join(os.environ["ROOM_TEST_TMP"], "issues-calls.ndjson"), "a") as log:
    log.write(json.dumps({"prompt": args[args.index("-p") + 1], "tools": flag("--tools"), "allowed": flag("--allowedTools")}) + "\n")
out = lambda o: print(json.dumps(o), flush=True)
out({"type": "system", "subtype": "init", "session_id": "coen-session"})
out({"type": "stream_event", "parent_tool_use_id": None, "event": {"type": "message_start"}})
if "show what you are starting on" in args[args.index("-p") + 1]:
    # Thinking, then composing a Write: both blocks start well before the step itself arrives. The pause gives the
    # suite time to be watching, as what an agent has just started on only goes to pages that are.
    time.sleep(1.5)
    start = lambda block: out({"type": "stream_event", "parent_tool_use_id": None, "event": {"type": "content_block_start", "content_block": block}})
    start({"type": "thinking", "thinking": "", "signature": ""})
    start({"type": "tool_use", "id": "W1", "name": "Write", "input": {}})
    out({"type": "assistant", "parent_tool_use_id": None, "message": {"content": [{"type": "tool_use", "id": "W1", "name": "Write", "input": {"file_path": "notes.md", "content": "x"}}]}})
    out({"type": "user", "parent_tool_use_id": None, "message": {"content": [{"type": "tool_result", "tool_use_id": "W1", "content": "refused", "is_error": True}]}})
    # Then a consult Coen waits for: the peer's two steps arrive complete, with no block starts of its own.
    out({"type": "assistant", "parent_tool_use_id": None, "message": {"content": [{"type": "tool_use", "id": "A1", "name": "Agent", "input": {"subagent_type": "room-otto", "prompt": "Your view?"}}]}})
    for i in ("R1", "R2"):
        out({"type": "assistant", "parent_tool_use_id": "A1", "message": {"content": [{"type": "tool_use", "id": i, "name": "Read", "input": {"file_path": "notes.md"}}]}})
    for i in ("R1", "R2"):
        out({"type": "user", "parent_tool_use_id": "A1", "message": {"content": [{"type": "tool_result", "tool_use_id": i, "content": "x"}]}})
    out({"type": "user", "parent_tool_use_id": None, "message": {"content": [{"type": "tool_result", "tool_use_id": "A1", "content": "Looks fine."}]}})
out({"type": "stream_event", "parent_tool_use_id": None, "event": {"type": "content_block_delta", "delta": {"type": "text_delta", "text": "Read."}}})
out({"type": "result", "is_error": False, "num_turns": 1, "total_cost_usd": 0.01, "session_id": "x"})
