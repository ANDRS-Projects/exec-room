#!/usr/bin/env python3
# Test double for `claude -p`: Coen proposes exactly what the message gives after "REC:" (one JSON object), so a check
# can name a page that only exists once an earlier proposal was approved. Logs to $ROOM_TEST_TMP/pageupdate-calls.ndjson
# whether the room's note offers the update action. Emits stream-json.
import json, os, sys

args = sys.argv[1:]
prompt = args[args.index("-p") + 1].split("(End of the room note on settings.)]\n\n", 1)[-1]
note = args[args.index("--append-system-prompt") + 1]
out = lambda o: print(json.dumps(o), flush=True)
with open(os.path.join(os.environ["ROOM_TEST_TMP"], "pageupdate-calls.ndjson"), "a") as log:
    log.write(json.dumps({"offers_update": '"notion_page_update"' in note, "names_first": "First doc (" in note}) + "\n")
text = "Here." + ("\n```recommendation\n" + prompt.split("REC:", 1)[1].strip() + "\n```\n" if "REC:" in prompt else "")
out({"type": "system", "subtype": "init", "session_id": "coen-session"})
out({"type": "stream_event", "parent_tool_use_id": None, "event": {"type": "message_start"}})
out({"type": "stream_event", "parent_tool_use_id": None, "event": {"type": "content_block_delta", "delta": {"type": "text_delta", "text": text}}})
out({"type": "result", "is_error": False, "num_turns": 1, "total_cost_usd": 0.01, "session_id": "x"})
