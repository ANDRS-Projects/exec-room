# Exec Room configuration
# Copy this file to a secure location and export these variables in your shell before running the room.
# The room-server.js does not load a .env file itself; you must export these in your shell.

# Web server port (default: 4179)
# export PORT=4179

# Path to room.config.json (default: ./room.config.json in the repo root)
# export ROOM_CONFIG_FILE=room.config.json

# Path to the data directory where chats and jobs are stored (default: ./data)
# export ROOM_DATA_DIR=data

# Timeout in milliseconds for fetching GitHub issues (default: 15000)
# export ROOM_ISSUE_FETCH_TIMEOUT_MS=15000

# The room checks at every start that agents are not given Claude Code's own CLAUDE.md files or its memory index
# (one small run, about a cent). Set to "off" to skip the check; the switches that keep those files out stay on.
# To let agents have those files after all, set "agentsGetClaudeFiles": true in room.config.json instead.
# export ROOM_CONTEXT_CHECK=off

# Notion API base URL (default: https://api.notion.com/v1)
# export ROOM_NOTION_API=https://api.notion.com/v1

# Notion integration token (optional). Connecting Notion in Exec Room settings (Popular MCPs → Notion → Connect) needs
# no token; without either, Notion actions are off.
# Obtain this from https://www.notion.so/my-integrations and share it with your databases
# export ROOM_NOTION_TOKEN=ntn_...

# Reference to a 1Password item containing the Notion token (optional; used only if ROOM_NOTION_TOKEN is not set)
# Format: op://vault-name/item-name/field-name
# Example: export ROOM_NOTION_TOKEN_REF="op://Private/Notion Integration/token"
# export ROOM_NOTION_TOKEN_REF=

# How runs are paid for: "subscription" (your Claude plan, the default) or "api-key" (pay-as-you-go).
# `npm run room:key` sets it to api-key for you.
# export ROOM_AUTH=subscription

# Key mode only: the Anthropic API key, or a 1Password reference to it (read once with `op read`)
# export ROOM_ANTHROPIC_API_KEY=sk-ant-...
# export ROOM_ANTHROPIC_API_KEY_REF="op://vault-name/item-name/field-name"

# Key mode only: the most one run may spend, and the most all runs may spend in a day, in US dollars
# export ROOM_RUN_CAP_USD=2
# export ROOM_DAY_CAP_USD=10

# Runs and gh start with a short, fixed environment. Names of further variables to pass on (one a version manager
# uses to find node, say), separated by commas:
# export ROOM_PASS_ENV=NVM_DIR,VOLTA_HOME

# The MCP catalog the settings page offers (default: ./mcp-catalog.json)
# export ROOM_MCP_CATALOG=mcp-catalog.json

# Claude Code must be on the system PATH, and logged in to your Claude plan unless the room runs in key mode
# Test with: which claude
