# Exec Room configuration
# Copy this file to a secure location and export these variables in your shell before running the room.
# The room-server.js does not load a .env file itself; you must export these in your shell.

# Web server port (default: 4179)
# export PORT=4179

# Path to room.config.json (default: ./room.config.json in the repo root)
# export ROOM_CONFIG_FILE=room.config.json

# Path to the data directory where chats and jobs are stored (default: ./data)
# export ROOM_DATA_DIR=data

# Timeout in milliseconds for fetching GitHub issues (default: 15000)
# export ROOM_ISSUE_FETCH_TIMEOUT_MS=15000

# Notion API base URL (default: https://api.notion.com/v1)
# export ROOM_NOTION_API=https://api.notion.com/v1

# Notion integration token (optional; if not set, Notion actions are disabled)
# Obtain this from https://www.notion.so/my-integrations and share it with your databases
# export ROOM_NOTION_TOKEN=secret_...

# Reference to a 1Password item containing the Notion token (optional; used only if ROOM_NOTION_TOKEN is not set)
# Format: op://vault-name/item-name/field-name
# Example: export ROOM_NOTION_TOKEN_REF="op://Private/Notion Integration/token"
# export ROOM_NOTION_TOKEN_REF=

# Claude Code must be logged in to your Claude plan and on the system PATH
# Test with: which claude
