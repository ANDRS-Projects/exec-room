{
  "display_information": {
    "name": "Exec Room",
    "description": "Sends you each proposal from your Exec Room, to approve or dismiss from Slack.",
    "background_color": "#1d2b4f"
  },
  "features": {
    "bot_user": {
      "display_name": "Exec Room",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
