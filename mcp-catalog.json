{
  "money-magician": {
    "name": "Money Magician",
    "by": "ANDRS, the makers of Exec Room",
    "description": "Read invoices, customers, vendors, taxes, profitability and reconciliation from your books.",
    "token": {
      "url": "https://mcp.moneymagician.eu/",
      "where": "Money Magician: Settings, API Tokens"
    },
    "connect": {
      "url": "https://mcp.moneymagician.eu/",
      "scope": "mcp:read"
    },
    "claudeAi": "Money_Magician",
    "check": {
      "tool": "get_financial_summary",
      "arguments": {}
    },
    "tools": {
      "query_invoices": "reads",
      "get_invoice_details": "reads",
      "search_customers": "reads",
      "get_financial_summary": "reads",
      "calculate_taxes": "reads",
      "list_created_invoices": "reads",
      "get_expenses_by_category": "reads",
      "get_profitability_metrics": "reads",
      "get_tax_position": "reads",
      "get_reconciliation_status": "reads",
      "get_top_customers": "reads",
      "get_top_vendors": "reads",
      "get_vendor_summary": "reads"
    }
  },
  "notion": {
    "name": "Notion",
    "by": "Notion",
    "description": "Search, open and query your Notion workspace, and save what you approve: drafts, pages and updates, only to the places each room may use.",
    "connect": {
      "url": "https://mcp.notion.com/mcp"
    },
    "check": {
      "tool": "notion-get-self",
      "arguments": {}
    },
    "tools": {
      "notion-search": "reads",
      "notion-fetch": "reads",
      "notion-query-data-sources": "reads"
    }
  },
  "github": {
    "name": "GitHub",
    "by": "GitHub",
    "description": "Read code, issues, pull requests, commits and releases in the repos your token allows, and in every public repo on GitHub, in every room that switches it on. Read-only: GitHub's read-only address, and a read-only token.",
    "token": {
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "where": "GitHub: Settings, Developer settings, Fine-grained tokens. Resource owner: the organisation (or you); only the repos agents may read; Contents, Issues, Pull requests and Metadata read-only"
    },
    "check": { "tool": "get_me", "arguments": {} },
    "tools": {
      "get_file_contents": "reads",
      "get_commit": "reads",
      "list_commits": "reads",
      "list_branches": "reads",
      "list_tags": "reads",
      "get_tag": "reads",
      "list_releases": "reads",
      "get_latest_release": "reads",
      "get_release_by_tag": "reads",
      "issue_read": "reads",
      "list_issues": "reads",
      "list_issue_fields": "reads",
      "list_issue_types": "reads",
      "get_label": "reads",
      "pull_request_read": "reads",
      "list_pull_requests": "reads",
      "search_code": "reads",
      "search_commits": "reads",
      "search_issues": "reads",
      "search_pull_requests": "reads",
      "search_repositories": "reads"
    }
  }
}
